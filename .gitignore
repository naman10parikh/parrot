# wikimem
.wikimem-cache/
node_modules/

# WikiMem test vault personal data
my-wiki/raw/
tools/agentgrid/app/release/

packages/web/.next/
*.pack

# macOS metadata
**/.DS_Store

# Ephemeral harness state (never commit)
.claude/worktrees/
.claude/backups/
.claude/scheduled_tasks.lock
.claude/vp-signals/*.done
.claude/vp-signals/*.needs-qa
.claude/vp-signals/*.migrating

# Obsidian temp files
vault/Untitled*.base

# parrot brain BM25 index — derived cache, self-rebuilds when stale (A4)
brain/.brain-index.json

# parrot CLI compiled output — derived from src/ via `pnpm build` (B2)
dist/

# parrot RSI deterministic-loop proposal output — derived, never committed (D2; keeps the tree clean post-run)
.rsi/

# Playwright cockpit-E2E artifacts — regenerated each run; the spec is the source of truth (G2)
test-results/
playwright-report/
.playwright/

# Secrets: ignore every .env variant, but KEEP the committed template (F3).
# The negation MUST come after the ignore line — git applies the last match.
.env*
!.env.example
